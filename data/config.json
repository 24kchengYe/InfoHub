{
  "ai": {
    "provider": "openai",
    "model": "deepseek/deepseek-chat-v3-0324",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "languages": ["zh", "en"]
  },
  "server": {
    "host": "0.0.0.0",
    "port": 18899
  },
  "scheduler": {
    "enabled": true,
    "cron": "0 */4 * * *",
    "default_hours": 24
  }
}
